{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {"type": "command", "command": "${user_config.python}", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session.py"]}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write",
        "hooks": [
          {"type": "command", "command": "${user_config.python}", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.py"]}
        ]
      }
    ]
  }
}
